# Copy this file to ".env" for local development and fill in a real
# OpenWeatherMap API key (get one free at https://openweathermap.org/api).
# ".env" is gitignored so your real key never gets committed.
#
# On Vercel, the same variable is set under:
# Project -> Settings -> Environment Variables

VITE_OPENWEATHER_API_KEY=your_api_key_here
